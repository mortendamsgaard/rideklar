{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freestyle requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "title",
    "audience",
    "description",
    "source",
    "duration",
    "maxScore",
    "technicalRequirements",
    "artisticAssessments",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "freestyle"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "documentDate",
        "checkedOn"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "documentDate": {
          "type": "string",
          "format": "date"
        },
        "checkedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minSeconds",
        "maxSeconds",
        "requiresClarification"
      ],
      "properties": {
        "minSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requiresClarification": {
          "type": "boolean"
        },
        "alternativeMinSecondsInSource": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "maxScore": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "technicalRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceNumber",
          "title",
          "description",
          "tip",
          "gait",
          "coefficient",
          "maxMark"
        ],
        "properties": {
          "sourceNumber": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tip": {
            "type": "string",
            "minLength": 1
          },
          "gait": {
            "enum": [
              "skridt",
              "trav",
              "galop",
              "neutral"
            ]
          },
          "coefficient": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxMark": {
            "const": 10
          },
          "movement": {
            "enum": [
              "schenkelvigning",
              "versade",
              "travers"
            ]
          },
          "minimumDistanceMeters": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "circleDiameterMeters": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "direction": {
            "type": "string",
            "minLength": 1
          },
          "walkSteps": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "artisticAssessments": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceNumber",
          "title",
          "description",
          "coefficient",
          "maxMark"
        ],
        "properties": {
          "sourceNumber": {
            "type": "integer",
            "minimum": 16,
            "maximum": 20
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "coefficient": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxMark": {
            "const": 10
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
